# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Tiger Cloud service URL, from the Tiger Cloud console.
# INK_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Gemini key for intent ranking and the memory layer.
# Get one from https://aistudio.google.com/apikey (starts with AIza or AQ.).
GEMINI_API_KEY=
# Models tried in order, first one that answers wins. Defaults to
# gemini-3.5-flash-lite then gemini-3.6-flash, both verified with image input.
# The lite model leads because gemini-3.8-flash allows only 20 free requests a
# day. Do not use gemini-2.5-flash: still listed, but 404s for new keys.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Pinning a single primary also keeps the defaults behind it as fallbacks.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait on ranking before dropping to the next vendor.
# GEMINI_TIMEOUT_S=15
# Budget for work nobody is waiting on: the end-of-day compression and the
# memory-graph patch, both of which run after the pad has already spoken.
# GEMINI_SLOW_TIMEOUT_S=120

# xAI key, tried after every Gemini model has refused. A different vendor, so a
# Google outage or an exhausted Google quota does not reach it, and unlike the
# on-machine model it handles the full prompt with all the patient context.
# Get one from https://console.x.ai (starts with xai-).
# XAI_API_KEY=
# Set to 0 to skip xAI even when a key is present.
# XAI_FALLBACK=1
# Chosen for latency, not accuracy: it answers in about 2.4s, which is what a
# refused Gemini call leaves of the budget. Do not use grok-4.3, which scored
# 0/3 on the eval drawings.
# XAI_MODEL=grok-4.20-0309-non-reasoning
# Used only for the unhurried calls above. It reads these drawings better than
# any other model tried, Gemini included, but spends 42-86s reasoning.
# XAI_SLOW_MODEL=grok-4.6

# When every Gemini model fails, the drawing is read by a vision model served by
# Ollama on this machine, which needs no key, network, or quota. Set to 0 to skip
# it and fall straight through to the stroke templates; worth doing on a machine
# with no GPU, where it is far slower than the budget allows.
# LOCAL_VISION=1
# Must be a model that accepts images. gemma3:12b needs roughly 8GB of VRAM and
# measured better and faster than qwen2.5vl:7b on the eval drawings.
# LOCAL_VISION_MODEL=gemma3:12b
# Its own budget, separate from Gemini's, since it only runs after Gemini failed.
# LOCAL_VISION_TIMEOUT_S=25
# OLLAMA_URL=http://127.0.0.1:11434

# Set to 0 to skip ranking and speak SAMPLE_TEXT (the browser tests do this).
# INK_RECOGNITION=1

# ElevenLabs key for speaking the result on the tablet. Without it the tablet
# uses its own voice engine instead, so this is optional.
# ELEVENLABS_API_KEY=
# Optional: any premade voice id, and the model to spend credits on.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5
